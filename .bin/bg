#!/usr/bin/env bash

set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-picker"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
WP_DIR="${WALLPAPER_LIBRARY_DIR:-$HOME/.wp}"
SOURCE_URL="${UNSPLASH_SOURCE_URL:-https://unsplash.it/3840/2160/?random}"

CURRENT_PREVIEW=""
CURRENT_STAMP=""
WEZTERM_BIN=""

mkdir -p "$CACHE_DIR" "$WALLPAPER_DIR" "$WP_DIR"

cleanup() {
  if [ -n "${CURRENT_PREVIEW:-}" ] && [ -f "${CURRENT_PREVIEW:-}" ]; then
    rm -f "$CURRENT_PREVIEW"
  fi
}

trap cleanup EXIT

style_block() {
  gum style \
    --border rounded \
    --border-foreground 63 \
    --padding "0 1" \
    --margin "1 0" \
    "$@"
}

style_note() {
  gum style --foreground 246 "$@"
}

style_error() {
  gum style --foreground 196 --bold "$@"
}

style_success() {
  gum style --foreground 42 --bold "$@"
}

usage() {
  cat <<EOF
Usage: bg [-r|--random]
  -r, --random   randomly set wallpaper from $WP_DIR
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    style_error "Не найдена команда: $1" >&2
    exit 1
  fi
}

resolve_wezterm() {
  if command -v wezterm >/dev/null 2>&1; then
    WEZTERM_BIN="$(command -v wezterm)"
    return
  fi

  if [ -x "/Applications/WezTerm.app/Contents/MacOS/wezterm" ]; then
    WEZTERM_BIN="/Applications/WezTerm.app/Contents/MacOS/wezterm"
    return
  fi

  style_error "WezTerm не найден. Ожидал \`wezterm\` в PATH или /Applications/WezTerm.app." >&2
  exit 1
}

ensure_setup() {
  require_cmd wget
  require_cmd gum
  require_cmd osascript
  resolve_wezterm

  if [ "${TERM_PROGRAM:-}" != "WezTerm" ]; then
    style_note "Подсказка: лучше запускать из WezTerm, чтобы превью через imgcat точно отрисовалось."
  fi
}

clear_current_file() {
  if [ -n "$CURRENT_PREVIEW" ] && [ -f "$CURRENT_PREVIEW" ]; then
    rm -f "$CURRENT_PREVIEW"
  fi

  CURRENT_PREVIEW=""
  CURRENT_STAMP=""
}

build_request_url() {
  local separator='?'

  case "$SOURCE_URL" in
    *\?*) separator='&' ;;
  esac

  printf '%s%s_cb=%s-%s\n' "$SOURCE_URL" "$separator" "$(date +%s)" "$RANDOM"
}

fetch_photo() {
  local request_url
  local fetch_status=0

  clear_current_file

  CURRENT_STAMP="$(date +%Y%m%d-%H%M%S)-$RANDOM"
  CURRENT_PREVIEW="$(mktemp "$CACHE_DIR/wallpaper.XXXXXX.jpg")"
  request_url="$(build_request_url)"

  URL="$request_url" OUTPUT="$CURRENT_PREVIEW" \
    gum spin \
      --spinner dot \
      --title "Скачиваю следующую картинку" \
      --show-error \
      -- bash -lc '
        wget -q -O "$OUTPUT" "$URL"
      ' || fetch_status=$?

  if [ "$fetch_status" -ne 0 ] || [ ! -s "$CURRENT_PREVIEW" ]; then
    style_error "Не удалось скачать картинку." >&2
    return 1
  fi
}

show_photo() {
  clear

  style_block "Wallpaper Picker"
  style_note "Источник: $SOURCE_URL"
  printf '\n'
  "$WEZTERM_BIN" imgcat --width 100% "$CURRENT_PREVIEW"
  printf '\n'
}

next_name_suggestions() {
  find "$WP_DIR" -maxdepth 1 -type f \( \
      -iname '*.jpg' -o \
      -iname '*.jpeg' -o \
      -iname '*.png' -o \
      -iname '*.webp' \
    \) -print 2>/dev/null |
    sed 's#^.*/##' |
    sed 's/\.[^.]*$//' |
    awk '
      {
        stem=$0
        if (match(stem, /[0-9]+$/)) {
          base=substr(stem, 1, RSTART-1)
          n=substr(stem, RSTART)+0
        } else {
          base=stem
          n=1
        }
        if (n > max[base]) max[base]=n
      }
      END {
        for (base in max) print base (max[base] + 1)
      }
    ' | sort
}

prompt_wallpaper_name() {
  local suggestions
  local name

  suggestions="$(next_name_suggestions)"

  if [ -n "$suggestions" ]; then
    name="$(printf '%s\n' "$suggestions" | gum filter \
      --header "Как назвать обои? Введи своё или выбери подсказку" \
      --placeholder "Например: sea4" \
      --height 10 \
      --no-fuzzy \
      --no-strict)" || exit 130
  else
    name="$(gum input \
      --header "Как назвать обои?" \
      --placeholder "Например: sea1")" || exit 130
  fi

  name="$(printf '%s' "$name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  name="${name##*/}"
  name="${name%.*}"

  if [ -z "$name" ]; then
    style_error "Имя не может быть пустым." >&2
    return 1
  fi

  printf '%s\n' "$name"
}

save_to_library() {
  local source_file="$1"
  local ext="${source_file##*.}"
  local name target

  while true; do
    name="$(prompt_wallpaper_name)" || continue
    target="$WP_DIR/$name.$ext"

    if [ -e "$target" ]; then
      if gum confirm "Файл $name.$ext уже есть. Перезаписать?"; then
        cp "$source_file" "$target"
        printf '%s\n' "$target"
        return
      fi
      continue
    fi

    cp "$source_file" "$target"
    printf '%s\n' "$target"
    return
  done
}

set_wallpaper_from_file() {
  local source_file="$1"
  local stamp="${CURRENT_STAMP:-$(date +%Y%m%d-%H%M%S)-$RANDOM}"
  local ext="${source_file##*.}"
  local target_file="$WALLPAPER_DIR/wallpaper-${stamp}.${ext}"
  local escaped_file

  cp "$source_file" "$target_file"
  escaped_file="$(printf '%s' "$target_file" | sed 's/\\/\\\\/g; s/"/\\"/g')"

  if ! osascript <<EOF
tell application "System Events"
  repeat with desktopRef in desktops
    set picture of desktopRef to POSIX file "$escaped_file"
  end repeat
end tell
EOF
  then
    style_error "Не удалось установить обои. Возможно, терминалу нужен доступ в System Events." >&2
    exit 1
  fi

  style_success "Обои установлены: $target_file"
}

pick_random_library_wallpaper() {
  local -a wallpapers
  local file

  while IFS= read -r -d '' file; do
    wallpapers+=("$file")
  done < <(find "$WP_DIR" -maxdepth 1 -type f \( \
      -iname '*.jpg' -o \
      -iname '*.jpeg' -o \
      -iname '*.png' -o \
      -iname '*.webp' \
    \) -print0)

  if [ "${#wallpapers[@]}" -eq 0 ]; then
    style_error "В $WP_DIR пока нет сохранённых обоев." >&2
    exit 1
  fi

  printf '%s\n' "${wallpapers[$((RANDOM % ${#wallpapers[@]}))]}"
}

set_random_wallpaper() {
  local selected

  selected="$(pick_random_library_wallpaper)"
  CURRENT_STAMP="$(date +%Y%m%d-%H%M%S)-$RANDOM"
  set_wallpaper_from_file "$selected"
  style_note "Случайные обои: ${selected##*/}"
}

main() {
  local action random_mode=0 saved_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -r|--random)
        random_mode=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        style_error "Неизвестный флаг: $1" >&2
        usage
        exit 1
        ;;
    esac
    shift
  done

  ensure_setup

  if [ "$random_mode" -eq 1 ]; then
    set_random_wallpaper
    exit 0
  fi

  while true; do
    if ! fetch_photo; then
      action="$(gum choose \
        --header "Не получилось скачать картинку. Что делаем?" \
        --cursor-prefix "→ " \
        --selected-prefix "✓ " \
        --height 3 \
        "Повторить" \
        "Выход")" || exit 130

      case "$action" in
        "Повторить") continue ;;
        "Выход") exit 0 ;;
      esac
    fi

    while true; do
      show_photo

      action="$(gum choose \
        --header "Что делаем?" \
        --cursor-prefix "→ " \
        --selected-prefix "✓ " \
        --height 3 \
        "Поставить на обои" \
        "Следующая" \
        "Выход")" || exit 130

      case "$action" in
        "Поставить на обои")
          saved_file="$(save_to_library "$CURRENT_PREVIEW")"
          set_wallpaper_from_file "$saved_file"
          style_note "Сохранено в библиотеку: $saved_file"
          exit 0
          ;;
        "Следующая")
          break
          ;;
        "Выход")
          exit 0
          ;;
      esac
    done
  done
}

main "$@"
